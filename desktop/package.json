{
  "name": "elekhwa-shop",
  "version": "1.0.0",
  "description": "برنامج محل الإخوة للأدوات الكهربائية والمنزلية",
  "author": "محمد سعيد - 01123840671",
  "main": "main.js",
  "scripts": { "dist": "electron-builder --win nsis --x64 --publish never" },
  "devDependencies": { "electron": "33.2.1", "electron-builder": "25.1.8" },
  "build": {
    "appId": "com.msaeed.elekhwa",
    "productName": "ElEkhwa Shop",
    "files": ["main.js", "icon.png"],
    "win": { "target": "nsis", "icon": "icon.png" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "محل الإخوة",
      "artifactName": "ElEkhwaSetup.exe"
    }
  }
}
