rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isMember() {
      return request.auth != null &&
        request.auth.token.email in get(/databases/$(db)/documents/meta/members).data.users;
    }
    match /meta/members {
      allow get: if true;
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.token.email
        && request.resource.data.users == [request.auth.token.email];
      allow update: if request.auth != null
        && resource.data.owner == request.auth.token.email
        && request.resource.data.owner == resource.data.owner;
    }
    match /meta/settings {
      allow read, write: if isMember();
    }
    match /{coll}/{id} {
      allow read, write: if coll != 'meta' && isMember();
    }
  }
}
